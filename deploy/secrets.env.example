# alpaca-mind secrets — LOCAL STAGING ONLY.
#
# Copy this file to secrets.env (same folder or the repo root), fill in
# the values below in any text editor, and save. Your AI assistant then
# runs deploy/push-secrets.sh, which moves these into AWS SSM Parameter
# Store (encrypted) WITHOUT printing them anywhere, and deletes the
# file. secrets.env is gitignored — never commit it, never share it.
#
# No quotes needed around values.

# From app.alpaca.markets → Paper Trading → generate API keys.
ALPACA_API_KEY=<YOUR_ALPACA_KEY>
ALPACA_SECRET_KEY=<YOUR_ALPACA_SECRET>

# "true" = paper trading. The default, and the right first deployment.
ALPACA_PAPER=true

# Printed by `claude setup-token`. Your AI assistant can run that
# command for you — a browser window opens and you just click Approve.
CLAUDE_CODE_OAUTH_TOKEN=<YOUR_CLAUDE_TOKEN>

# Any strong password you choose. It gates the whole web interface
# (username: owner).
UI_PASSWORD=<CHOOSE_A_PASSWORD>
